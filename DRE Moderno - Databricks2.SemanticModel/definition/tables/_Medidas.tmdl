			RETURN
			    IF ( ISBLANK ( _MC ), BLANK (), _MC + [DRE | Despesas Operacionais Previsto] + [DRE | Outras Receitas e Despesas Previsto] )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 7fbbcb5b-9193-4819-a101-18a367b785ce

	/// Fase 5 (CVM): EBIT Previsto = EBITDA + Depreciação e Amortização. Resultado Líquido = EBIT + Resultado Financeiro + IR/CSLL.
	measure 'EBIT | Previsto' =
			VAR _E = [EBITDA | Previsto]
			RETURN
			    IF ( ISBLANK ( _E ), BLANK (), _E + [DRE | Depreciação e Amortização Previsto] )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 334197a7-12ae-430f-824c-1ec48d385f6d

	/// Fase 5 (CVM): EBITDA Previsto no período comparável = soma de DRE | Previsto Comparável nas linhas 5, 6 e 10. BLANK se qualquer componente for BLANK (mesmas guardas de cobertura).
	measure 'EBITDA | Previsto Comparável' =
			VAR _MC = CALCULATE ( [DRE | Previsto Comparável], TREATAS ( { 5 }, 'vw_dre_comparativo'[ordem_dre] ) )
			VAR _DO = CALCULATE ( [DRE | Previsto Comparável], TREATAS ( { 6 }, 'vw_dre_comparativo'[ordem_dre] ) )
			VAR _OR = CALCULATE ( [DRE | Previsto Comparável], TREATAS ( { 10 }, 'vw_dre_comparativo'[ordem_dre] ) )
			RETURN
			    IF ( ISBLANK ( _MC ) || ISBLANK ( _DO ) || ISBLANK ( _OR ), BLANK (), _MC + _DO + _OR )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: d1a3db7e-7da6-4492-be54-ba05284c3cd1

	/// Fase 5 (CVM): EBIT Previsto no período comparável = EBITDA comparável + DRE | Previsto Comparável da linha 9. BLANK se faltar componente.
	measure 'EBIT | Previsto Comparável' =
			VAR _E = [EBITDA | Previsto Comparável]
			VAR _DA = CALCULATE ( [DRE | Previsto Comparável], TREATAS ( { 9 }, 'vw_dre_comparativo'[ordem_dre] ) )
			RETURN
			    IF ( ISBLANK ( _E ) || ISBLANK ( _DA ), BLANK (), _E + _DA )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: e5e5a9cc-f328-4542-a830-55daedd1e82f

	/// Fase 5: EBITDA Realizado − Orçado comparáveis. Positivo = favorável. BLANK se faltar operando.
	measure 'EBITDA | Desvio x Orçado (R$)' =
			VAR _R = [EBITDA | Realizado Comparável]
			VAR _X = [EBITDA | Orçado Comparável]
			RETURN
			    IF ( ISBLANK ( _R ) || ISBLANK ( _X ), BLANK (), _R - _X )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 9079d22d-409d-429d-ac1a-cef6787e3348

	/// Fase 5: (EBITDA Realizado − Orçado) ÷ |Orçado| comparáveis. BLANK se faltar operando ou Orçado = 0.
	measure 'EBITDA | Desvio x Orçado (%)' =
			VAR _R = [EBITDA | Realizado Comparável]
			VAR _X = [EBITDA | Orçado Comparável]
			RETURN
			    IF ( ISBLANK ( _R ) || ISBLANK ( _X ) || _X = 0, BLANK (), DIVIDE ( _R - _X, ABS ( _X ) ) )
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 8e94b6fd-a30a-41c3-9072-f42f1230d5b0

	/// Fase 5: Favorável / Em linha (|desvio| ≤ R$ 0,01) / Desfavorável do EBITDA x Orçado. BLANK sem desvio.
	measure 'EBITDA | Classificação x Orçado' =
			VAR _D = [EBITDA | Desvio x Orçado (R$)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _D ), BLANK (),
			        ABS ( _D ) <= 0.01 + 0.000000001, "Em linha",
			        _D > 0, "Favorável",
			        "Desfavorável"
			    )
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 05d0a3ae-baba-4040-b782-729993bc6ca6

	/// Fase 5: EBITDA Realizado − Previsto comparáveis. Positivo = favorável. BLANK se faltar operando.
	measure 'EBITDA | Desvio x Previsto (R$)' =
			VAR _R = [EBITDA | Realizado Comparável]
			VAR _X = [EBITDA | Previsto Comparável]
			RETURN
			    IF ( ISBLANK ( _R ) || ISBLANK ( _X ), BLANK (), _R - _X )
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 6e1d9ad2-a8ce-4290-84aa-25ded7807a08

	/// Fase 5: (EBITDA Realizado − Previsto) ÷ |Previsto| comparáveis. BLANK se faltar operando ou Previsto = 0.
	measure 'EBITDA | Desvio x Previsto (%)' =
			VAR _R = [EBITDA | Realizado Comparável]
			VAR _X = [EBITDA | Previsto Comparável]
			RETURN
			    IF ( ISBLANK ( _R ) || ISBLANK ( _X ) || _X = 0, BLANK (), DIVIDE ( _R - _X, ABS ( _X ) ) )
		formatString: 0.00%;(0.00%);0.00%
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: cf15f2b0-9c2f-4ba7-b07d-2e5106e2e97d

	/// Fase 5: Favorável / Em linha (|desvio| ≤ R$ 0,01) / Desfavorável do EBITDA x Previsto. BLANK sem desvio.
	measure 'EBITDA | Classificação x Previsto' =
			VAR _D = [EBITDA | Desvio x Previsto (R$)]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _D ), BLANK (),
			        ABS ( _D ) <= 0.01 + 0.000000001, "Em linha",
			        _D > 0, "Favorável",
			        "Desfavorável"
			    )
		displayFolder: DRE\EBITDA e EBIT
		lineageTag: 2ed7ea29-2fa2-4a84-99e6-ed5ba61053ae

	/// Fase 5: cor da classificação do EBITDA x Orçado (formatação condicional).
	measure 'EBITDA | Cor x Orçado' =
			SWITCH (
			    [EBITDA | Classificação x Orçado],
			    "Favorável", "#107C10",
			    "Desfavorável", "#C50F1F",
			    "Em linha", "#605E5C",
			    BLANK ()
			)
		isHidden
		displayFolder: DRE\EBITDA e EBIT
