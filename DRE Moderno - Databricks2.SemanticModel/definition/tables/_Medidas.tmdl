	/// Realizado exclusivamente da posição 13. Aceito pelo usuário em 09/11/2026 após conciliação com o Databricks (base didática DIDATICA-1.0). Filtros de posição conflitantes retornam BLANK.
	measure 'DRE | Resultado Líquido Realizado' =
			CALCULATE (
				[DRE | Realizado],
				KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 13 )
			)
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\Resultado Líquido
		lineageTag: ae9c3c48-fc4b-47d2-ae7a-4c4921a014ca

