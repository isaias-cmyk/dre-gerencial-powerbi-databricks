table _Medidas
	lineageTag: e6ba04e3-b25a-41b0-81e4-6aab755fd0e2

	/// Realizado ajustado da view para uma única posição DRE. Total entre posições e indicadores EBIT/EBITDA pendentes retornam BLANK.
	measure 'DRE | Realizado' =
			VAR _Descricao = SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] )
			RETURN
				IF (
					HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
						&& NOT ISBLANK ( _Descricao )
						&& NOT CONTAINSSTRING ( _Descricao, "EBIT" ),
					SUM ( 'vw_dre_comparativo'[realizado] ),
					BLANK ()
				)
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\Bases
		lineageTag: 9afc2c72-5e4a-4be2-a6e9-6cd7ca93a820

	/// Orçado ajustado da view para uma única posição DRE. Não soma analíticas com subtotais nem calcula EBIT/EBITDA pendentes.
	measure 'DRE | Orçado' =
			VAR _Descricao = SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] )
			RETURN
				IF (
					HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
						&& NOT ISBLANK ( _Descricao )
						&& NOT CONTAINSSTRING ( _Descricao, "EBIT" ),
					SUM ( 'vw_dre_comparativo'[orcado] ),
					BLANK ()
				)
		formatString: R$ #,##0.00;(R$ #,##0.00);R$ 0.00
		displayFolder: DRE\Bases
		lineageTag: d32fcf20-faa2-46d9-88e9-ce965ccf4df6

