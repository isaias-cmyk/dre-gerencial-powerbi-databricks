	/// L4.1: posição da linha DRE da conta (via mascaradre_id → dim_dre).
	column ordem_dre = LOOKUPVALUE ( dim_dre[ordem_dre], dim_dre[id_dre], dim_conta[mascaradre_id] )
		dataType: int64
		isHidden
		lineageTag: 3b78fa02-fe3d-4a56-907b-c9f49d23f846
		summarizeBy: none

	/// L4.1: linha da DRE da conta (via mascaradre_id → dim_dre). Ordenada por ordem_dre.
	column linha_dre = LOOKUPVALUE ( dim_dre[descricao_dre], dim_dre[id_dre], dim_conta[mascaradre_id] )
		dataType: string
		lineageTag: 2bd8cdb5-e662-403e-9f5d-b49c940784a1
		sortByColumn: ordem_dre

	/// L4.1: ordem de exibição do grupo (descricaon1) = menor ordem_conta do grupo.
	column ordem_grupo = VAR _g = dim_conta[descricaon1] RETURN MINX ( FILTER ( ALLNOBLANKROW ( dim_conta[descricaon1], dim_conta[ordem_conta] ), dim_conta[descricaon1] = _g ), dim_conta[ordem_conta] )
		dataType: int64
		isHidden
		lineageTag: 96250265-7f29-4675-ac47-f280d46c4902
		summarizeBy: none

	/// L4.1: ordem de exibição da conta (descricaon2) = menor ordem_conta.
	column ordem_subconta = VAR _c = dim_conta[descricaon2] RETURN MINX ( FILTER ( ALLNOBLANKROW ( dim_conta[descricaon2], dim_conta[ordem_conta] ), dim_conta[descricaon2] = _c ), dim_conta[ordem_conta] )
		dataType: int64
		isHidden
		lineageTag: ff227fb9-01ec-4be0-b05b-e84be2d80a2f
		summarizeBy: none

	/// L4.1: grupo da conta (cópia de descricaon1 para exibição), ordenado por ordem_grupo.
	column grupo_conta = dim_conta[descricaon1]
		dataType: string
		lineageTag: 681ef56a-54d8-4f10-838a-9dc2ac1cf050
		sortByColumn: ordem_grupo

	/// L4.1: conta (cópia de descricaon2 para exibição), ordenada por ordem_subconta.
	column conta = dim_conta[descricaon2]
		dataType: string
		lineageTag: b5179bd0-88dc-4054-8eae-29a10356ba2d
		sortByColumn: ordem_subconta

