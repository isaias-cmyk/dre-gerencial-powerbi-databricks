// Lote 2.1: consulta de leitura. NÃO EXECUTADA nas medidas persistidas.
// Executar após reabrir o PBIP atualizado; não criar medidas a partir destes testes.
EVALUATE
VAR _Datas=FILTER(ALL('dim_calendario'),'dim_calendario'[data]>=DATE(2023,6,1) && 'dim_calendario'[data]<DATE(2024,1,1))
RETURN CALCULATETABLE(
 ROW("BaseRealizado",[DRE | Realizado],"RLRealizadoProvisorio",[DRE | Resultado Líquido Realizado],
 "AprovadoAusencia",ISBLANK([DRE | Realizado]) && ISBLANK([DRE | Resultado Líquido Realizado]),
 "Orcado",[DRE | Orçado],"Previsto",[DRE | Previsto]),
 _Datas,'vw_dre_comparativo'[ordem_dre]=13)
