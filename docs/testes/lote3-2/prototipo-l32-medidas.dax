DEFINE
MEASURE '_Medidas'[P37] =
    VAR _Filiais = SELECTCOLUMNS ( VALUES ( 'dim_filial'[cod_filial] ), "__Filial", 'dim_filial'[cod_filial] )
    VAR _Datas = VALUES ( 'dim_calendario'[data] )
    VAR _Meses = SELECTCOLUMNS ( VALUES ( 'dim_calendario'[inicio_mes] ), "__Mes", 'dim_calendario'[inicio_mes] )
    VAR _Cfg = ALL ( '_ConfigCobertura' )
    VAR _Versao = CONCATENATEX ( DISTINCT ( '_ConfigCobertura'[versao_contrato] ), '_ConfigCobertura'[versao_contrato], ", " )
    VAR _CfgInvalida =
        COUNTROWS ( _Cfg ) = 0
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[versao_contrato] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[hash_base] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || COUNTROWS ( FILTER ( _Cfg,
            ISBLANK ( '_ConfigCobertura'[inicio_competencia] ) || ISBLANK ( '_ConfigCobertura'[fim_competencia] )
            || '_ConfigCobertura'[inicio_competencia] > '_ConfigCobertura'[fim_competencia]
            || DAY ( '_ConfigCobertura'[inicio_competencia] ) <> 1 || DAY ( '_ConfigCobertura'[fim_competencia] ) <> 1
            || '_ConfigCobertura'[estado] <> "FORNECIDO_DIDATICO"
            || ISBLANK ( '_ConfigCobertura'[versao_contrato] ) || ISBLANK ( '_ConfigCobertura'[hash_base] ) ) ) > 0
    VAR _MesParcial = COUNTROWS ( FILTER ( _Meses,
        VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Datas, 'dim_calendario'[data] >= _M && 'dim_calendario'[data] <= EOMONTH ( _M, 0 ) ) ) <> DAY ( EOMONTH ( _M, 0 ) ) ) ) > 0
    VAR _SemConfiguracao = COUNTROWS ( FILTER ( _Filiais,
        VAR _F = [__Filial]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado" ) ) = 0 ) ) > 0
    VAR _Grade = ADDCOLUMNS ( CROSSJOIN ( _Filiais, _Meses ),
        "__R", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__O", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Orcado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__P", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Previsto"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ) )
    VAR _Cortes = ADDCOLUMNS ( _Filiais, "__Corte",
        VAR _F = [__Filial] RETURN MAXX ( FILTER ( _Grade, [__Filial] = _F && [__R] = 1 ), [__Mes] ) )
    VAR _SemCobertura = COUNTROWS ( FILTER ( _Cortes, ISBLANK ( [__Corte] ) ) ) > 0
    VAR _Corte = MINX ( _Cortes, [__Corte] )
    VAR _Pares = FILTER ( _Grade, NOT ISBLANK ( _Corte ) && [__Mes] <= _Corte )
    VAR _Lacuna = COUNTROWS ( FILTER ( _Pares, [__R] <> 1 ) ) > 0
    VAR _FaltaCfgO = COUNTROWS ( FILTER ( _Pares, [__O] <> 1 ) ) > 0
    VAR _FaltaCfgP = COUNTROWS ( FILTER ( _Pares, [__P] <> 1 ) ) > 0
    VAR _PosicaoValida = HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
        && NOT ISBLANK ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ) )
        && NOT CONTAINSSTRING ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ), "EBIT" )
    VAR _ContextoInvalido = _CfgInvalida || _SemConfiguracao || _MesParcial || _Lacuna
        || COUNTROWS ( _Filiais ) = 0 || COUNTROWS ( _Meses ) = 0 || NOT _PosicaoValida
    VAR _Mascara = SELECTCOLUMNS ( _Pares, "__F", [__Filial], "__M", [__Mes] )
    VAR _Pres = CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( 'vw_dre_comparativo', 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ),
        "__VR", [DRE | Realizado] ),
        KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) )
    VAR _NPares = COUNTROWS ( _Pares )
    VAR _FaltaR = COUNTROWS ( FILTER ( _Pres, NOT ISBLANK ( [__VR] ) ) ) < _NPares
    RETURN
        IF ( _ContextoInvalido || _SemCobertura || COUNTROWS ( _Pares ) = 0 || _FaltaR, BLANK (),
            CALCULATE ( [DRE | Realizado], KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ) )
MEASURE '_Medidas'[P38] =
    VAR _Filiais = SELECTCOLUMNS ( VALUES ( 'dim_filial'[cod_filial] ), "__Filial", 'dim_filial'[cod_filial] )
    VAR _Datas = VALUES ( 'dim_calendario'[data] )
    VAR _Meses = SELECTCOLUMNS ( VALUES ( 'dim_calendario'[inicio_mes] ), "__Mes", 'dim_calendario'[inicio_mes] )
    VAR _Cfg = ALL ( '_ConfigCobertura' )
    VAR _Versao = CONCATENATEX ( DISTINCT ( '_ConfigCobertura'[versao_contrato] ), '_ConfigCobertura'[versao_contrato], ", " )
    VAR _CfgInvalida =
        COUNTROWS ( _Cfg ) = 0
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[versao_contrato] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[hash_base] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || COUNTROWS ( FILTER ( _Cfg,
            ISBLANK ( '_ConfigCobertura'[inicio_competencia] ) || ISBLANK ( '_ConfigCobertura'[fim_competencia] )
            || '_ConfigCobertura'[inicio_competencia] > '_ConfigCobertura'[fim_competencia]
            || DAY ( '_ConfigCobertura'[inicio_competencia] ) <> 1 || DAY ( '_ConfigCobertura'[fim_competencia] ) <> 1
            || '_ConfigCobertura'[estado] <> "FORNECIDO_DIDATICO"
            || ISBLANK ( '_ConfigCobertura'[versao_contrato] ) || ISBLANK ( '_ConfigCobertura'[hash_base] ) ) ) > 0
    VAR _MesParcial = COUNTROWS ( FILTER ( _Meses,
        VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Datas, 'dim_calendario'[data] >= _M && 'dim_calendario'[data] <= EOMONTH ( _M, 0 ) ) ) <> DAY ( EOMONTH ( _M, 0 ) ) ) ) > 0
    VAR _SemConfiguracao = COUNTROWS ( FILTER ( _Filiais,
        VAR _F = [__Filial]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado" ) ) = 0 ) ) > 0
    VAR _Grade = ADDCOLUMNS ( CROSSJOIN ( _Filiais, _Meses ),
        "__R", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__O", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Orcado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__P", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Previsto"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ) )
    VAR _Cortes = ADDCOLUMNS ( _Filiais, "__Corte",
        VAR _F = [__Filial] RETURN MAXX ( FILTER ( _Grade, [__Filial] = _F && [__R] = 1 ), [__Mes] ) )
    VAR _SemCobertura = COUNTROWS ( FILTER ( _Cortes, ISBLANK ( [__Corte] ) ) ) > 0
    VAR _Corte = MINX ( _Cortes, [__Corte] )
    VAR _Pares = FILTER ( _Grade, NOT ISBLANK ( _Corte ) && [__Mes] <= _Corte )
    VAR _Lacuna = COUNTROWS ( FILTER ( _Pares, [__R] <> 1 ) ) > 0
    VAR _FaltaCfgO = COUNTROWS ( FILTER ( _Pares, [__O] <> 1 ) ) > 0
    VAR _FaltaCfgP = COUNTROWS ( FILTER ( _Pares, [__P] <> 1 ) ) > 0
    VAR _PosicaoValida = HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
        && NOT ISBLANK ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ) )
        && NOT CONTAINSSTRING ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ), "EBIT" )
    VAR _ContextoInvalido = _CfgInvalida || _SemConfiguracao || _MesParcial || _Lacuna
        || COUNTROWS ( _Filiais ) = 0 || COUNTROWS ( _Meses ) = 0 || NOT _PosicaoValida
    VAR _Mascara = SELECTCOLUMNS ( _Pares, "__F", [__Filial], "__M", [__Mes] )
    VAR _Pres = CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( 'vw_dre_comparativo', 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ),
        "__VR", [DRE | Realizado],
        "__VO", [DRE | Orçado] ),
        KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) )
    VAR _NPares = COUNTROWS ( _Pares )
    VAR _FaltaR = COUNTROWS ( FILTER ( _Pres, NOT ISBLANK ( [__VR] ) ) ) < _NPares
    VAR _FaltaO = _FaltaCfgO || COUNTROWS ( FILTER ( _Pres, NOT ISBLANK ( [__VO] ) ) ) < _NPares
    RETURN
        IF ( _ContextoInvalido || _SemCobertura || COUNTROWS ( _Pares ) = 0 || _FaltaR || _FaltaO, BLANK (),
            CALCULATE ( [DRE | Orçado], KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ) )
MEASURE '_Medidas'[P39] =
    VAR _Filiais = SELECTCOLUMNS ( VALUES ( 'dim_filial'[cod_filial] ), "__Filial", 'dim_filial'[cod_filial] )
    VAR _Datas = VALUES ( 'dim_calendario'[data] )
    VAR _Meses = SELECTCOLUMNS ( VALUES ( 'dim_calendario'[inicio_mes] ), "__Mes", 'dim_calendario'[inicio_mes] )
    VAR _Cfg = ALL ( '_ConfigCobertura' )
    VAR _Versao = CONCATENATEX ( DISTINCT ( '_ConfigCobertura'[versao_contrato] ), '_ConfigCobertura'[versao_contrato], ", " )
    VAR _CfgInvalida =
        COUNTROWS ( _Cfg ) = 0
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[versao_contrato] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || CALCULATE ( DISTINCTCOUNT ( '_ConfigCobertura'[hash_base] ), REMOVEFILTERS ( '_ConfigCobertura' ) ) <> 1
        || COUNTROWS ( FILTER ( _Cfg,
            ISBLANK ( '_ConfigCobertura'[inicio_competencia] ) || ISBLANK ( '_ConfigCobertura'[fim_competencia] )
            || '_ConfigCobertura'[inicio_competencia] > '_ConfigCobertura'[fim_competencia]
            || DAY ( '_ConfigCobertura'[inicio_competencia] ) <> 1 || DAY ( '_ConfigCobertura'[fim_competencia] ) <> 1
            || '_ConfigCobertura'[estado] <> "FORNECIDO_DIDATICO"
            || ISBLANK ( '_ConfigCobertura'[versao_contrato] ) || ISBLANK ( '_ConfigCobertura'[hash_base] ) ) ) > 0
    VAR _MesParcial = COUNTROWS ( FILTER ( _Meses,
        VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Datas, 'dim_calendario'[data] >= _M && 'dim_calendario'[data] <= EOMONTH ( _M, 0 ) ) ) <> DAY ( EOMONTH ( _M, 0 ) ) ) ) > 0
    VAR _SemConfiguracao = COUNTROWS ( FILTER ( _Filiais,
        VAR _F = [__Filial]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado" ) ) = 0 ) ) > 0
    VAR _Grade = ADDCOLUMNS ( CROSSJOIN ( _Filiais, _Meses ),
        "__R", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__O", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Orcado"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
        "__P", VAR _F = [__Filial] VAR _M = [__Mes]
            RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Previsto"
                && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ) )
    VAR _Cortes = ADDCOLUMNS ( _Filiais, "__Corte",
        VAR _F = [__Filial] RETURN MAXX ( FILTER ( _Grade, [__Filial] = _F && [__R] = 1 ), [__Mes] ) )
    VAR _SemCobertura = COUNTROWS ( FILTER ( _Cortes, ISBLANK ( [__Corte] ) ) ) > 0
    VAR _Corte = MINX ( _Cortes, [__Corte] )
    VAR _Pares = FILTER ( _Grade, NOT ISBLANK ( _Corte ) && [__Mes] <= _Corte )
    VAR _Lacuna = COUNTROWS ( FILTER ( _Pares, [__R] <> 1 ) ) > 0
    VAR _FaltaCfgO = COUNTROWS ( FILTER ( _Pares, [__O] <> 1 ) ) > 0
    VAR _FaltaCfgP = COUNTROWS ( FILTER ( _Pares, [__P] <> 1 ) ) > 0
    VAR _PosicaoValida = HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
        && NOT ISBLANK ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ) )
        && NOT CONTAINSSTRING ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ), "EBIT" )
    VAR _ContextoInvalido = _CfgInvalida || _SemConfiguracao || _MesParcial || _Lacuna
        || COUNTROWS ( _Filiais ) = 0 || COUNTROWS ( _Meses ) = 0 || NOT _PosicaoValida
    VAR _Mascara = SELECTCOLUMNS ( _Pares, "__F", [__Filial], "__M", [__Mes] )
    VAR _Pres = CALCULATETABLE (
        ADDCOLUMNS ( SUMMARIZE ( 'vw_dre_comparativo', 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ),
        "__VR", [DRE | Realizado],
        "__VP", [DRE | Previsto] ),
        KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) )
    VAR _NPares = COUNTROWS ( _Pares )
    VAR _FaltaR = COUNTROWS ( FILTER ( _Pres, NOT ISBLANK ( [__VR] ) ) ) < _NPares
    VAR _FaltaP = _FaltaCfgP || COUNTROWS ( FILTER ( _Pres, NOT ISBLANK ( [__VP] ) ) ) < _NPares
    RETURN
        IF ( _ContextoInvalido || _SemCobertura || COUNTROWS ( _Pares ) = 0 || _FaltaR || _FaltaP, BLANK (),
            CALCULATE ( [DRE | Previsto], KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ) )
MEASURE '_Medidas'[P40] = VAR _R = [P37] VAR _O = [P38] RETURN IF ( ISBLANK ( _R ) || ISBLANK ( _O ), BLANK (), _R - _O )
MEASURE '_Medidas'[P42] = VAR _R = [P37] VAR _P = [P39] RETURN IF ( ISBLANK ( _R ) || ISBLANK ( _P ), BLANK (), _R - _P )
MEASURE '_Medidas'[P41] = VAR _R = [P37] VAR _O = [P38] RETURN IF ( ISBLANK ( _R ) || ISBLANK ( _O ) || _O = 0, BLANK (), DIVIDE ( _R - _O, ABS ( _O ) ) )
MEASURE '_Medidas'[P43] = VAR _R = [P37] VAR _P = [P39] RETURN IF ( ISBLANK ( _R ) || ISBLANK ( _P ) || _P = 0, BLANK (), DIVIDE ( _R - _P, ABS ( _P ) ) )
MEASURE '_Medidas'[P44] = VAR _D = [P40] VAR _Pos = SELECTEDVALUE ( 'vw_dre_comparativo'[ordem_dre] ) RETURN IF ( ISBLANK ( _D ) || NOT ( _Pos IN { 1, 2, 3, 4, 5, 6, 7, 9, 10, 12, 13 } ), BLANK (), _D )
MEASURE '_Medidas'[P45] = VAR _D = [P42] VAR _Pos = SELECTEDVALUE ( 'vw_dre_comparativo'[ordem_dre] ) RETURN IF ( ISBLANK ( _D ) || NOT ( _Pos IN { 1, 2, 3, 4, 5, 6, 7, 9, 10, 12, 13 } ), BLANK (), _D )
MEASURE '_Medidas'[P46] = VAR _I = [P44] VAR _Pos = SELECTEDVALUE ( 'vw_dre_comparativo'[ordem_dre] ) VAR _C = SWITCH ( TRUE (), ISBLANK ( _I ), BLANK (), ABS ( _I ) <= 0.01 + 0.000000001, "Em linha", _I > 0, "Favorável", "Desfavorável" ) RETURN IF ( ISBLANK ( _C ), BLANK (), _C & IF ( _Pos = 13, " (provisório)", "" ) )
MEASURE '_Medidas'[P47] = VAR _I = [P45] VAR _Pos = SELECTEDVALUE ( 'vw_dre_comparativo'[ordem_dre] ) VAR _C = SWITCH ( TRUE (), ISBLANK ( _I ), BLANK (), ABS ( _I ) <= 0.01 + 0.000000001, "Em linha", _I > 0, "Favorável", "Desfavorável" ) RETURN IF ( ISBLANK ( _C ), BLANK (), _C & IF ( _Pos = 13, " (provisório)", "" ) )
MEASURE '_Medidas'[P48] = VAR _Pos = SELECTEDVALUE ( 'vw_dre_comparativo'[ordem_dre] ) VAR _R = [P37] VAR _O = [P38] RETURN IF ( NOT ( _Pos IN { 1, 3 } ) || ISBLANK ( _R ) || ISBLANK ( _O ) || _O <= 0 || _R < 0, BLANK (), DIVIDE ( _R, _O ) )
