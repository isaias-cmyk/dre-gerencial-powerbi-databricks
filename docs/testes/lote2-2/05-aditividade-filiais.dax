// Somente leitura; NÃO EXECUTADO neste lote. Executar nas medidas persistidas após reabrir o PBIP.
EVALUATE UNION(VAR _C=[DRE | Receita Operacional Bruta Realizado] VAR _S=SUMX(VALUES('dim_filial'[cod_filial]),CALCULATE([DRE | Receita Operacional Bruta Realizado]))
