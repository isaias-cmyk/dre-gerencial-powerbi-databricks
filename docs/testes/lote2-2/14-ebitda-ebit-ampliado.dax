// Somente leitura; NÃO EXECUTADO neste lote. Executar nas medidas persistidas após reabrir o PBIP.
EVALUATE
VAR _Periodos = DATATABLE("Periodo",STRING,"InicioNumero",INTEGER,"FimNumero",INTEGER,{{"Integral",20210101,20240101},{"2021",20210101,20220101},{"2022",20220101,20230101},{"2023",20230101,20240101},{"2023_JanMai",20230101,20230601},{"2023_JunDez",20230601,20240101},{"2023_Junho",20230601,20230701}})
VAR _Filiais = DATATABLE("GrupoFilial",STRING,{{"Consolidado"},{"01"},{"02"},{"03"},{"01+02"}})
RETURN GENERATE(CROSSJOIN(_Filiais,_Periodos),
VAR _Grupo = [GrupoFilial]
VAR _I = [InicioNumero]
VAR _F = [FimNumero]
VAR _Inicio = DATE(INT(_I/10000),MOD(INT(_I/100),100),MOD(_I,100))
VAR _Fim = DATE(INT(_F/10000),MOD(INT(_F/100),100),MOD(_F,100))
VAR _Datas = FILTER(ALL('dim_calendario'), 'dim_calendario'[data]>=_Inicio && 'dim_calendario'[data]<_Fim)
VAR _FiltroFilial = FILTER(ALL('dim_filial'), _Grupo="Consolidado" || 'dim_filial'[cod_filial]=_Grupo || (_Grupo="01+02" && 'dim_filial'[cod_filial] IN {"01","02"}))
RETURN CALCULATETABLE(CALCULATETABLE(SUMMARIZECOLUMNS('vw_dre_comparativo'[ordem_dre],'vw_dre_comparativo'[descricao_dre],"LinhasFonte",COUNTROWS('vw_dre_comparativo'),"BaseR",[DRE | Realizado],"BaseO",[DRE | Orçado],"BaseP",[DRE | Previsto],"RLR",[DRE | Resultado Líquido Realizado],"RLO",[DRE | Resultado Líquido Orçado],"RLP",[DRE | Resultado Líquido Previsto],
"M07",[DRE | Receita Operacional Bruta Realizado],
"M08",[DRE | Receita Operacional Bruta Orçado],
"M09",[DRE | Receita Operacional Bruta Previsto],
"M10",[DRE | Deduções da Receita Realizado],
"M11",[DRE | Deduções da Receita Orçado],
"M12",[DRE | Deduções da Receita Previsto],
"M13",[DRE | Receita Operacional Líquida Realizado],
"M14",[DRE | Receita Operacional Líquida Orçado],
"M15",[DRE | Receita Operacional Líquida Previsto],
"M16",[DRE | Custos Realizado],
"M17",[DRE | Custos Orçado],
"M18",[DRE | Custos Previsto],
"M19",[DRE | Margem de Contribuição Realizado],
"M20",[DRE | Margem de Contribuição Orçado],
"M21",[DRE | Margem de Contribuição Previsto],
"M22",[DRE | Despesas Operacionais Realizado],
"M23",[DRE | Despesas Operacionais Orçado],
"M24",[DRE | Despesas Operacionais Previsto],
"M25",[DRE | Resultado Financeiro Realizado],
"M26",[DRE | Resultado Financeiro Orçado],
"M27",[DRE | Resultado Financeiro Previsto],
"M28",[DRE | Depreciação e Amortização Realizado],
"M29",[DRE | Depreciação e Amortização Orçado],
"M30",[DRE | Depreciação e Amortização Previsto],
"M31",[DRE | Outras Receitas e Despesas Realizado],
"M32",[DRE | Outras Receitas e Despesas Orçado],
"M33",[DRE | Outras Receitas e Despesas Previsto],
"M34",[DRE | Provisão para IR e CSLL Realizado],
"M35",[DRE | Provisão para IR e CSLL Orçado],
"M36",[DRE | Provisão para IR e CSLL Previsto]),KEEPFILTERS('vw_dre_comparativo'[ordem_dre] IN {8,11})),_Datas,_FiltroFilial))
ORDER BY [GrupoFilial],[Periodo]
