// Somente leitura; NÃO EXECUTADO neste lote. Executar nas medidas persistidas após reabrir o PBIP.
EVALUATE
VAR _Periodos = DATATABLE("Periodo",STRING,"InicioNumero",INTEGER,"FimNumero",INTEGER,{{"Integral",20210101,20240101},{"2021",20210101,20220101},{"2022",20220101,20230101},{"2023",20230101,20240101},{"2023_JanMai",20230101,20230601},{"2023_JunDez",20230601,20240101},{"2023_Junho",20230601,20230701}})
VAR _Filiais = DATATABLE("GrupoFilial",STRING,{{"Consolidado"},{"01"},{"02"},{"03"},{"01+02"}})
RETURN GENERATE(CROSSJOIN(_Filiais,_Periodos),
VAR _Grupo = [GrupoFilial]
VAR _I = [InicioNumero]
VAR _F = [FimNumero]
VAR _Inicio = DATE(INT(_I/10000),MOD(INT(_I/100),100),MOD(_I,100))
VAR _Fim = DATE(INT(_F/10000),MOD(INT(_F/100),100),MOD(_F,100))
VAR _Datas = FILTER(ALL('dim_calendario'), 'dim_calendario'[data]>=_Inicio && 'dim_calendario'[data]<_Fim)
VAR _FiltroFilial = FILTER(ALL('dim_filial'), _Grupo="Consolidado" || 'dim_filial'[cod_filial]=_Grupo || (_Grupo="01+02" && 'dim_filial'[cod_filial] IN {"01","02"}))
RETURN UNION(VAR _V=CALCULATE([DRE | Realizado],_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[realizado]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Realizado","Cenario","Realizado","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01)),
VAR _V=CALCULATE([DRE | Resultado Líquido Realizado],_Datas,_FiltroFilial)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[realizado]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Resultado Líquido Realizado","Cenario","Realizado","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01)),
VAR _V=CALCULATE([DRE | Orçado],_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[orcado]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Orçado","Cenario","Orçado","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01)),
VAR _V=CALCULATE([DRE | Resultado Líquido Orçado],_Datas,_FiltroFilial)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[orcado]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Resultado Líquido Orçado","Cenario","Orçado","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01)),
VAR _V=CALCULATE([DRE | Previsto],_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[previsto]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Previsto","Cenario","Previsto","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01)),
VAR _V=CALCULATE([DRE | Resultado Líquido Previsto],_Datas,_FiltroFilial)
VAR _E=CALCULATE(SUM('vw_dre_comparativo'[previsto]),_Datas,_FiltroFilial,'vw_dre_comparativo'[ordem_dre]=13)
RETURN ROW("Medida","DRE | Resultado Líquido Previsto","Cenario","Previsto","Obtido",_V,"Esperado",_E,"Diferenca",IF(NOT ISBLANK(_V) && NOT ISBLANK(_E),_V-_E),"Aprovado",IF(ISBLANK(_E),ISBLANK(_V),NOT ISBLANK(_V) && ABS(_V-_E)<=0.01))))
ORDER BY [GrupoFilial],[Periodo],[Medida]
