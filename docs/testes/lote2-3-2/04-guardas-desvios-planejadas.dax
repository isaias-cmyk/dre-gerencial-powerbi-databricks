-- PLANEJADO. Após implementação: todos os quatro números devem ser BLANK.
EVALUATE UNION ( ROW ( "Caso", "Total entre posicoes", "M40", [DRE | Desvio Realizado x Orçado (R$)], "M41", [DRE | Desvio Realizado x Orçado (%)], "M42", [DRE | Desvio Realizado x Previsto (R$)], "M43", [DRE | Desvio Realizado x Previsto (%)] ),
CALCULATETABLE ( ROW ( "Caso", "Datas parciais", "M40", [DRE | Desvio Realizado x Orçado (R$)], "M41", [DRE | Desvio Realizado x Orçado (%)], "M42", [DRE | Desvio Realizado x Previsto (R$)], "M43", [DRE | Desvio Realizado x Previsto (%)] ), DATESBETWEEN('dim_calendario'[data],DATE(2023,5,2),DATE(2023,5,31)), TREATAS({13},'vw_dre_comparativo'[ordem_dre]) ),
CALCULATETABLE ( ROW ( "Caso", "Posicao descricao conflitantes", "M40", [DRE | Desvio Realizado x Orçado (R$)], "M41", [DRE | Desvio Realizado x Orçado (%)], "M42", [DRE | Desvio Realizado x Previsto (R$)], "M43", [DRE | Desvio Realizado x Previsto (%)] ), TREATAS({1},'vw_dre_comparativo'[ordem_dre]), TREATAS({"descricao_inexistente_teste"},'vw_dre_comparativo'[descricao_dre]) ) )
