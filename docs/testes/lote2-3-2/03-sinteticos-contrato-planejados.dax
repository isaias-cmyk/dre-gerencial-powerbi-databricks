-- SINTETICO PLANEJADO, NÃO EXECUTADO. Verifica contrato algébrico; não valida medidas persistidas.
DEFINE VAR _Casos = DATATABLE ( "Caso", STRING, "R", DOUBLE, "X", DOUBLE, "DeltaEsperado", DOUBLE, "PercentualEsperado", DOUBLE,
 { { "positivo", 120, 100, 20, 0.2 },
{ "negativo", 80, 100, -20, -0.2 },
{ "igual", 100, 100, 0, 0 },
{ "referencia_negativa_desvio_negativo", -120, -100, -20, -0.2 },
{ "referencia_negativa_desvio_positivo", -80, -100, 20, 0.2 },
{ "resultado_negativo_menos_negativo", -20, -100, 80, 0.8 },
{ "realizado_zero", 0, 100, -100, -1 },
{ "zero_com_referencia_negativa", 0, -100, 100, 1 },
{ "referencia_zero", 20, 0, 20, BLANK () },
{ "ambos_zero", 0, 0, 0, BLANK () },
{ "realizado_blank", BLANK (), 100, BLANK (), BLANK () },
{ "referencia_blank", 100, BLANK (), BLANK (), BLANK () },
{ "ambos_blank", BLANK (), BLANK (), BLANK (), BLANK () },
{ "mudanca_sinal_positiva", 100, -100, 200, 2 },
{ "mudanca_sinal_negativa", -100, 100, -200, -2 } } )
EVALUATE
ADDCOLUMNS ( ADDCOLUMNS ( _Casos,
 "DeltaCalculado", IF ( ISBLANK([R]) || ISBLANK([X]), BLANK(), [R]-[X] ),
 "PercentualCalculado", IF ( ISBLANK([R]) || ISBLANK([X]) || [X]=0, BLANK(), DIVIDE([R]-[X],ABS([X])) ) ),
 "DeltaAprovado", IF ( ISBLANK([DeltaCalculado]) || ISBLANK([DeltaEsperado]), ISBLANK([DeltaCalculado]) && ISBLANK([DeltaEsperado]), ABS([DeltaCalculado]-[DeltaEsperado])<=0.01 ),
 "PercentualAprovado", IF ( ISBLANK([PercentualCalculado]) || ISBLANK([PercentualEsperado]), ISBLANK([PercentualCalculado]) && ISBLANK([PercentualEsperado]), ABS([PercentualCalculado]-[PercentualEsperado])<=0.00000001 ) )
