-- Teste somente leitura; datas constantes aqui representam o contrato de teste independente.
DEFINE VAR _Contextos = CROSSJOIN ( DATATABLE ( "Grupo", STRING, { {"01"}, {"02"}, {"03"}, {"Consolidado"}, {"01+02"} } ), DATATABLE ( "Periodo", STRING, { {"Integral"}, {"2021"}, {"2022"}, {"2023"}, {"2023_JanMai"}, {"2023_JunDez"}, {"2023_Maio"}, {"2023_Junho"}, {"2023_JanMar"} } ) )
EVALUATE ADDCOLUMNS ( GENERATE ( _Contextos,
 VAR _Grupo=[Grupo] VAR _Periodo=[Periodo]
 RETURN CALCULATETABLE ( UNION ( CALCULATETABLE ( ROW ( "Medida", "DRE | Realizado", "Valor", [DRE | Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Orçado", "Valor", [DRE | Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Previsto", "Valor", [DRE | Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Líquido Realizado", "Valor", [DRE | Resultado Líquido Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Líquido Orçado", "Valor", [DRE | Resultado Líquido Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Líquido Previsto", "Valor", [DRE | Resultado Líquido Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 13 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Bruta Realizado", "Valor", [DRE | Receita Operacional Bruta Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 1 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Bruta Orçado", "Valor", [DRE | Receita Operacional Bruta Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 1 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Bruta Previsto", "Valor", [DRE | Receita Operacional Bruta Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 1 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Deduções da Receita Realizado", "Valor", [DRE | Deduções da Receita Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 2 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Deduções da Receita Orçado", "Valor", [DRE | Deduções da Receita Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 2 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Deduções da Receita Previsto", "Valor", [DRE | Deduções da Receita Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 2 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Líquida Realizado", "Valor", [DRE | Receita Operacional Líquida Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 3 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Líquida Orçado", "Valor", [DRE | Receita Operacional Líquida Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 3 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Receita Operacional Líquida Previsto", "Valor", [DRE | Receita Operacional Líquida Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 3 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Custos Realizado", "Valor", [DRE | Custos Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 4 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Custos Orçado", "Valor", [DRE | Custos Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 4 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Custos Previsto", "Valor", [DRE | Custos Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 4 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Margem de Contribuição Realizado", "Valor", [DRE | Margem de Contribuição Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 5 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Margem de Contribuição Orçado", "Valor", [DRE | Margem de Contribuição Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 5 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Margem de Contribuição Previsto", "Valor", [DRE | Margem de Contribuição Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 5 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Despesas Operacionais Realizado", "Valor", [DRE | Despesas Operacionais Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 6 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Despesas Operacionais Orçado", "Valor", [DRE | Despesas Operacionais Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 6 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Despesas Operacionais Previsto", "Valor", [DRE | Despesas Operacionais Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 6 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Financeiro Realizado", "Valor", [DRE | Resultado Financeiro Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 7 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Financeiro Orçado", "Valor", [DRE | Resultado Financeiro Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 7 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Resultado Financeiro Previsto", "Valor", [DRE | Resultado Financeiro Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 7 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Depreciação e Amortização Realizado", "Valor", [DRE | Depreciação e Amortização Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 9 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Depreciação e Amortização Orçado", "Valor", [DRE | Depreciação e Amortização Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 9 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Depreciação e Amortização Previsto", "Valor", [DRE | Depreciação e Amortização Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 9 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Outras Receitas e Despesas Realizado", "Valor", [DRE | Outras Receitas e Despesas Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 10 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Outras Receitas e Despesas Orçado", "Valor", [DRE | Outras Receitas e Despesas Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 10 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Outras Receitas e Despesas Previsto", "Valor", [DRE | Outras Receitas e Despesas Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 10 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Provisão para IR e CSLL Realizado", "Valor", [DRE | Provisão para IR e CSLL Realizado], "Esperado", SUM ( 'vw_dre_comparativo'[realizado] ) ), TREATAS ( { 12 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Provisão para IR e CSLL Orçado", "Valor", [DRE | Provisão para IR e CSLL Orçado], "Esperado", SUM ( 'vw_dre_comparativo'[orcado] ) ), TREATAS ( { 12 }, 'vw_dre_comparativo'[ordem_dre] ) ),
CALCULATETABLE ( ROW ( "Medida", "DRE | Provisão para IR e CSLL Previsto", "Valor", [DRE | Provisão para IR e CSLL Previsto], "Esperado", SUM ( 'vw_dre_comparativo'[previsto] ) ), TREATAS ( { 12 }, 'vw_dre_comparativo'[ordem_dre] ) ) ),
FILTER ( ALL ( 'dim_filial'[cod_filial] ), _Grupo = "Consolidado" || 'dim_filial'[cod_filial] = _Grupo || ( _Grupo = "01+02" && 'dim_filial'[cod_filial] IN { "01", "02" } ) ),
FILTER ( ALL ( 'dim_calendario'[data] ),
    SWITCH ( _Periodo,
        "Integral", TRUE (), "2021", YEAR ( 'dim_calendario'[data] ) = 2021,
        "2022", YEAR ( 'dim_calendario'[data] ) = 2022,
        "2023", YEAR ( 'dim_calendario'[data] ) = 2023,
        "2023_JanMai", YEAR ( 'dim_calendario'[data] ) = 2023 && MONTH ( 'dim_calendario'[data] ) <= 5,
        "2023_JunDez", YEAR ( 'dim_calendario'[data] ) = 2023 && MONTH ( 'dim_calendario'[data] ) >= 6,
        "2023_Maio", YEAR ( 'dim_calendario'[data] ) = 2023 && MONTH ( 'dim_calendario'[data] ) = 5,
        "2023_Junho", YEAR ( 'dim_calendario'[data] ) = 2023 && MONTH ( 'dim_calendario'[data] ) = 6,
        "2023_JanMar", YEAR ( 'dim_calendario'[data] ) = 2023 && MONTH ( 'dim_calendario'[data] ) IN { 1, 3 }, FALSE () ) ) ) ),
 "Aprovado", IF ( ISBLANK([Valor]) || ISBLANK([Esperado]), ISBLANK([Valor]) && ISBLANK([Esperado]), ABS([Valor]-[Esperado]) <= 0.01 ),
 "Diferenca", IF ( NOT ISBLANK([Valor]) && NOT ISBLANK([Esperado]), [Valor]-[Esperado] ) )
ORDER BY [Grupo],[Periodo],[Medida]
