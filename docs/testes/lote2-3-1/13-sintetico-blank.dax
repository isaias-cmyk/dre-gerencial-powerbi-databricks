        || ISBLANK ( '_ConfigCobertura'[versao_contrato] ) || ISBLANK ( '_ConfigCobertura'[hash_base] ) ) ) > 0
VAR _MesParcial = COUNTROWS ( FILTER ( _Meses,
    VAR _M = [__Mes]
    RETURN COUNTROWS ( FILTER ( _Datas, 'dim_calendario'[data] >= _M && 'dim_calendario'[data] <= EOMONTH ( _M, 0 ) ) ) <> DAY ( EOMONTH ( _M, 0 ) ) ) ) > 0
VAR _SemConfiguracao = COUNTROWS ( FILTER ( _Filiais,
    VAR _F = [__Filial]
    RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado" ) ) = 0 ) ) > 0
VAR _Grade = ADDCOLUMNS ( CROSSJOIN ( _Filiais, _Meses ),
    "__R", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Realizado"
            && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
    "__O", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Orcado"
            && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ),
    "__P", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN COUNTROWS ( FILTER ( _Cfg, '_ConfigCobertura'[cod_filial] = _F && '_ConfigCobertura'[cenario] = "Previsto"
            && '_ConfigCobertura'[inicio_competencia] <= _M && '_ConfigCobertura'[fim_competencia] >= _M ) ) )
VAR _Cortes = ADDCOLUMNS ( _Filiais, "__Corte",
    VAR _F = [__Filial] RETURN MAXX ( FILTER ( _Grade, [__Filial] = _F && [__R] = 1 ), [__Mes] ) )
VAR _SemCobertura = COUNTROWS ( FILTER ( _Cortes, ISBLANK ( [__Corte] ) ) ) > 0
VAR _Corte = MINX ( _Cortes, [__Corte] )
VAR _Pares = FILTER ( _Grade, NOT ISBLANK ( _Corte ) && [__Mes] <= _Corte )
VAR _Lacuna = COUNTROWS ( FILTER ( _Pares, [__R] <> 1 ) ) > 0
VAR _FaltaCfgO = COUNTROWS ( FILTER ( _Pares, [__O] <> 1 ) ) > 0
VAR _FaltaCfgP = COUNTROWS ( FILTER ( _Pares, [__P] <> 1 ) ) > 0
VAR _PosicaoValida = HASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )
    && NOT ISBLANK ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ) )
    && NOT CONTAINSSTRING ( SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] ), "EBIT" )
VAR _ContextoInvalido = _CfgInvalida || _SemConfiguracao || _MesParcial || _Lacuna
    || COUNTROWS ( _Filiais ) = 0 || COUNTROWS ( _Meses ) = 0 || NOT _PosicaoValida
VAR _Mascara = SELECTCOLUMNS ( _Pares, "__F", [__Filial], "__M", [__Mes] )
VAR _Dados = ADDCOLUMNS ( _Pares,
    "__VR", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN CALCULATE ( [DRE | Realizado], KEEPFILTERS ( TREATAS ( { ( _F, _M ) }, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ),
    "__VO", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN CALCULATE ( [DRE | Orçado], KEEPFILTERS ( TREATAS ( { ( _F, _M ) }, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ),
    "__VP", VAR _F = [__Filial] VAR _M = [__Mes]
        RETURN CALCULATE ( [DRE | Previsto], KEEPFILTERS ( TREATAS ( { ( _F, _M ) }, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ) )
VAR _FaltaR = COUNTROWS ( FILTER ( _Dados, ISBLANK ( [__VR] ) ) ) > 0
VAR _FaltaO = _FaltaCfgO || COUNTROWS ( FILTER ( _Dados, ISBLANK ( [__VO] ) ) ) > 0
VAR _FaltaP = _FaltaCfgP || COUNTROWS ( FILTER ( _Dados, ISBLANK ( [__VP] ) ) ) > 0
RETURN
    IF ( _ContextoInvalido || _SemCobertura || COUNTROWS ( _Pares ) = 0 || _FaltaR || _FaltaO, BLANK (),
        CALCULATE ( [DRE | Orçado], KEEPFILTERS ( TREATAS ( _Mascara, 'vw_dre_comparativo'[cod_filial], 'vw_dre_comparativo'[competencia] ) ) ) )
 MEASURE '_Medidas'[DRE | Previsto Comparável] =
