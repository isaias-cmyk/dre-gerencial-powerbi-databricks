// TESTE CONSOLIDADO — LOTE 2.2
// Somente leitura: uma consulta EVALUATE; sem DEFINE MEASURE ou alterações no modelo.
// Nomes conferidos diretamente em _Medidas.tmdl: 36 medidas únicas.
// Inventário exato (as seis primeiras são do Lote 2.1; as demais são testadas abaixo):
// DRE | Realizado
// DRE | Orçado
// DRE | Previsto
// DRE | Resultado Líquido Realizado
// DRE | Resultado Líquido Orçado
// DRE | Resultado Líquido Previsto
// DRE | Receita Operacional Bruta Realizado
// DRE | Receita Operacional Bruta Orçado
// DRE | Receita Operacional Bruta Previsto
// DRE | Deduções da Receita Realizado
// DRE | Deduções da Receita Orçado
// DRE | Deduções da Receita Previsto
// DRE | Receita Operacional Líquida Realizado
// DRE | Receita Operacional Líquida Orçado
// DRE | Receita Operacional Líquida Previsto
// DRE | Custos Realizado
// DRE | Custos Orçado
// DRE | Custos Previsto
// DRE | Margem de Contribuição Realizado
// DRE | Margem de Contribuição Orçado
// DRE | Margem de Contribuição Previsto
// DRE | Despesas Operacionais Realizado
// DRE | Despesas Operacionais Orçado
// DRE | Despesas Operacionais Previsto
// DRE | Resultado Financeiro Realizado
// DRE | Resultado Financeiro Orçado
// DRE | Resultado Financeiro Previsto
// DRE | Depreciação e Amortização Realizado
// DRE | Depreciação e Amortização Orçado
// DRE | Depreciação e Amortização Previsto
// DRE | Outras Receitas e Despesas Realizado
// DRE | Outras Receitas e Despesas Orçado
// DRE | Outras Receitas e Despesas Previsto
// DRE | Provisão para IR e CSLL Realizado
// DRE | Provisão para IR e CSLL Orçado
// DRE | Provisão para IR e CSLL Previsto

// EXECUÇÃO: abrir o PBIP atualizado, Exibição de Consulta DAX > Nova consulta,
// colar TODO este arquivo e Executar. Não usar a barra de criação de medidas.
// Esperadas 30 linhas, ordenadas por posição e cenário Realizado/Orçado/Previsto.
// Ajustar somente as três variáveis de contexto abaixo e executar novamente.
// Filial "" = consolidado; "01" = São Paulo; "02" = Rio de Janeiro; "03" = Florianópolis.
// Consultas DAX não herdam automaticamente os segmentadores das páginas do relatório.
// Datas inclusivas. Integral: 01/01/2021 a 31/12/2023. Testar também 2021, 2022,
// janeiro-maio/2023 e junho-dezembro/2023 (Realizado deve permanecer BLANK neste último).
// O cálculo direto usa SUM na mesma coluna/cenário e KEEPFILTERS na posição específica.
// Os sinais são preservados; não soma as 13 posições nem recalcula subtotais.
// Diferenca = ValorMedida - ValorDireto, sem arredondar. BLANK não é tratado como zero.
// Aprovado exige ausência coincidente ou diferença absoluta <= R$ 0,01.
// Ambos BLANK: Diferenca BLANK e Status OK_BLANK. Só um BLANK: DIVERGENCIA_BLANK.
// Cada execução compara o modelo importado consigo mesmo; não substitui conciliação SQL,
// testes de filtros conflitantes, matriz, metadados e regressões do roteiro completo.
// Consulta preparada e conferida estaticamente; execução dinâmica ainda não comprovada.

EVALUATE
VAR _CodigoFilial = ""
VAR _DataInicial = DATE ( 2021, 1, 1 )
VAR _DataFinal = DATE ( 2023, 12, 31 )
VAR _Tolerancia = 0.01
RETURN
    CALCULATETABLE (
        VAR _Resultados =
            UNION (
                VAR _Medida = [DRE | Receita Operacional Bruta Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 1 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Bruta",
                        "PosicaoDRE", 1,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Receita Operacional Bruta Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Receita Operacional Bruta Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 1 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Bruta",
                        "PosicaoDRE", 1,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Receita Operacional Bruta Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Receita Operacional Bruta Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 1 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Bruta",
                        "PosicaoDRE", 1,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Receita Operacional Bruta Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Deduções da Receita Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 2 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Deduções da Receita",
                        "PosicaoDRE", 2,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Deduções da Receita Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Deduções da Receita Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 2 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Deduções da Receita",
                        "PosicaoDRE", 2,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Deduções da Receita Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Deduções da Receita Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 2 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Deduções da Receita",
                        "PosicaoDRE", 2,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Deduções da Receita Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Receita Operacional Líquida Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 3 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Líquida",
                        "PosicaoDRE", 3,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Receita Operacional Líquida Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Receita Operacional Líquida Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 3 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Líquida",
                        "PosicaoDRE", 3,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Receita Operacional Líquida Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Receita Operacional Líquida Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 3 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Receita Operacional Líquida",
                        "PosicaoDRE", 3,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Receita Operacional Líquida Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Custos Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 4 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Custos",
                        "PosicaoDRE", 4,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Custos Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Custos Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 4 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Custos",
                        "PosicaoDRE", 4,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Custos Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Custos Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 4 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Custos",
                        "PosicaoDRE", 4,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Custos Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Margem de Contribuição Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 5 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Margem de Contribuição",
                        "PosicaoDRE", 5,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Margem de Contribuição Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Margem de Contribuição Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 5 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Margem de Contribuição",
                        "PosicaoDRE", 5,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Margem de Contribuição Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Margem de Contribuição Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 5 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Margem de Contribuição",
                        "PosicaoDRE", 5,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Margem de Contribuição Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Despesas Operacionais Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 6 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Despesas Operacionais",
                        "PosicaoDRE", 6,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Despesas Operacionais Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Despesas Operacionais Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 6 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Despesas Operacionais",
                        "PosicaoDRE", 6,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Despesas Operacionais Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Despesas Operacionais Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 6 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Despesas Operacionais",
                        "PosicaoDRE", 6,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Despesas Operacionais Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Resultado Financeiro Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 7 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Resultado Financeiro",
                        "PosicaoDRE", 7,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Resultado Financeiro Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Resultado Financeiro Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 7 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Resultado Financeiro",
                        "PosicaoDRE", 7,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Resultado Financeiro Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Resultado Financeiro Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 7 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Resultado Financeiro",
                        "PosicaoDRE", 7,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Resultado Financeiro Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Depreciação e Amortização Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 9 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Depreciação e Amortização",
                        "PosicaoDRE", 9,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Depreciação e Amortização Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Depreciação e Amortização Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 9 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Depreciação e Amortização",
                        "PosicaoDRE", 9,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Depreciação e Amortização Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Depreciação e Amortização Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 9 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Depreciação e Amortização",
                        "PosicaoDRE", 9,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Depreciação e Amortização Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Outras Receitas e Despesas Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 10 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Outras Receitas e Despesas",
                        "PosicaoDRE", 10,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Outras Receitas e Despesas Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Outras Receitas e Despesas Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 10 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Outras Receitas e Despesas",
                        "PosicaoDRE", 10,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Outras Receitas e Despesas Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Outras Receitas e Despesas Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 10 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Outras Receitas e Despesas",
                        "PosicaoDRE", 10,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Outras Receitas e Despesas Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Provisão para IR e CSLL Realizado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[realizado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 12 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Provisão para IR e CSLL",
                        "PosicaoDRE", 12,
                        "OrdemCenario", 1,
                        "Cenario", "Realizado",
                        "NomeMedida", "DRE | Provisão para IR e CSLL Realizado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Provisão para IR e CSLL Orçado]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[orcado] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 12 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Provisão para IR e CSLL",
                        "PosicaoDRE", 12,
                        "OrdemCenario", 2,
                        "Cenario", "Orçado",
                        "NomeMedida", "DRE | Provisão para IR e CSLL Orçado",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    ),
                VAR _Medida = [DRE | Provisão para IR e CSLL Previsto]
                VAR _Direto =
                    CALCULATE (
                        SUM ( 'vw_dre_comparativo'[previsto] ),
                        KEEPFILTERS ( 'vw_dre_comparativo'[ordem_dre] = 12 )
                    )
                RETURN
                    ROW (
                        "Indicador", "Provisão para IR e CSLL",
                        "PosicaoDRE", 12,
                        "OrdemCenario", 3,
                        "Cenario", "Previsto",
                        "NomeMedida", "DRE | Provisão para IR e CSLL Previsto",
                        "ValorMedida", _Medida,
                        "ValorDireto", _Direto
                    )
            )
        RETURN
            ADDCOLUMNS (
                _Resultados,
                "FilialConsultada", IF ( _CodigoFilial = "", "Consolidado", _CodigoFilial ),
                "DataInicial", _DataInicial,
                "DataFinal", _DataFinal,
                "Diferenca",
                    IF (
                        NOT ISBLANK ( [ValorMedida] ) && NOT ISBLANK ( [ValorDireto] ),
                        [ValorMedida] - [ValorDireto],
                        BLANK ()
                    ),
                "MedidaBlank", ISBLANK ( [ValorMedida] ),
                "DiretoBlank", ISBLANK ( [ValorDireto] ),
                "Aprovado",
                    IF (
                        ISBLANK ( [ValorMedida] ) || ISBLANK ( [ValorDireto] ),
                        ISBLANK ( [ValorMedida] ) && ISBLANK ( [ValorDireto] ),
                        ABS ( [ValorMedida] - [ValorDireto] ) <= _Tolerancia
                    ),
                "Status",
                    SWITCH (
                        TRUE (),
                        ISBLANK ( [ValorMedida] ) && ISBLANK ( [ValorDireto] ), "OK_BLANK",
                        ISBLANK ( [ValorMedida] ) || ISBLANK ( [ValorDireto] ), "DIVERGENCIA_BLANK",
                        ABS ( [ValorMedida] - [ValorDireto] ) <= _Tolerancia, "OK",
                        "DIVERGENCIA_VALOR"
                    )
            ),
        KEEPFILTERS (
            FILTER (
                ALL ( 'dim_filial'[cod_filial] ),
                _CodigoFilial = "" || 'dim_filial'[cod_filial] = _CodigoFilial
            )
        ),
        KEEPFILTERS (
            FILTER (
                ALL ( 'dim_calendario'[data] ),
                'dim_calendario'[data] >= _DataInicial
                    && 'dim_calendario'[data] <= _DataFinal
            )
        )
    )
ORDER BY [PosicaoDRE], [OrdemCenario]
