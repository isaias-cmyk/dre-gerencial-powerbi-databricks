  {
    "[ID]": 5114,
    "[Name]": "DRE | Realizado",
    "[Table]": "_Medidas",
    "[Description]": "Realizado ajustado da view para uma única posição DRE. Total entre posições e indicadores EBIT/EBITDA pendentes retornam BLANK.",
    "[DataType]": "Number",
    "[Expression]": "VAR _Descricao = SELECTEDVALUE ( 'vw_dre_comparativo'[descricao_dre] )\nRETURN\n\tIF (\n\t\tHASONEVALUE ( 'vw_dre_comparativo'[ordem_dre] )\n\t\t\t&& NOT ISBLANK ( _Descricao )\n\t\t\t&& NOT CONTAINSSTRING ( _Descricao, \"EBIT\" ),\n\t\tSUM ( 'vw_dre_comparativo'[realizado] ),\n\t\tBLANK ()\n\t)",
    "[FormatString]": null,
    "[IsHidden]": false,
    "[State]": "Valid",
    "[KPIID]": null,
    "[IsSimpleMeasure]": false,
    "[DisplayFolder]": "DRE\\Bases",
    "[DetailRowsDefinition]": null,
    "[DataCategory]": null,
    "[FormatStringDefinition]": "\"R$ #,##0.00;(R$ #,##0.00);R$ 0.00\"",
    "[LineageTag]": "9afc2c72-5e4a-4be2-a6e9-6cd7ca93a820"
  },
